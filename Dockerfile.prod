# syntax=docker/dockerfile:1

# --------------------------------------------------
# Dependencies
# --------------------------------------------------

FROM oven/bun:1.2.4-alpine AS base

WORKDIR /app

RUN chown bun:bun /app

# Copy manifests first for better dependency caching
COPY --chown=bun:bun package.json bun.lock turbo.json tsconfig.json ./
COPY --chown=bun:bun client/package.json ./client/package.json
COPY --chown=bun:bun server/package.json ./server/package.json
COPY --chown=bun:bun shared/package.json ./shared/package.json

# The root contains postinstall builds shared + server,
# so the workspace source must exist before bun install.
COPY --chown=bun:bun . .

USER bun

RUN bun install --frozen-lockfile

# Copy source only after dependencies


# --------------------------------------------------
# Build monorepo
# --------------------------------------------------

FROM base AS build

ARG VITE_APP_NAME="Coffee Platform"
ARG VITE_SERVER_URL

ENV VITE_APP_NAME=$VITE_APP_NAME
ENV VITE_SERVER_URL=$VITE_SERVER_URL

RUN bun run build


# --------------------------------------------------
# Production
# --------------------------------------------------

FROM oven/bun:1.2.4-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Runtime dependencies
COPY --from=build --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/package.json ./package.json

# Server
COPY --from=build --chown=bun:bun /app/server/package.json ./server/package.json
COPY --from=build --chown=bun:bun /app/server/dist ./server/dist
COPY --from=build --chown=bun:bun /app/server/public ./server/public

# Client build
COPY --from=build --chown=bun:bun /app/client/dist ./client/dist

# Shared package
COPY --from=build --chown=bun:bun /app/shared/package.json ./shared/package.json
COPY --from=build --chown=bun:bun /app/shared/dist ./shared/dist

USER bun

EXPOSE 3000

CMD ["bun", "server/dist/index.js"]